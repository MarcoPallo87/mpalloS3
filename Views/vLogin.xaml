<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mpalloS3.Views.vLogin"
             Title="vLogin">

    <ScrollView Orientation="Both">
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label 
                Text="INICIO DE SESION"
                FontSize="20"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <!--IMAGENES-->
            <!--Enlace Web (jpg - png)-->
            <!--Archivo jpg - png Dentro de los recursos-->
            <Image Source="sailor.jpg"
                   WidthRequest="100"/>
            <Image Source="login1.png"
                   WidthRequest="120"/>

            <Grid HorizontalOptions="Center"
                  VerticalOptions="Center"
                  RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Usuario:"
                       FontSize="18"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <Entry x:Name="txtUsuario"
                       Placeholder="Ingresa el Usuario"
                       Grid.Row="0"
                       Grid.Column="1"/>

                <Label Text="Contraseña:"
                       FontSize="18"
                       Grid.Row="1"
                       Grid.Column="0"/>
                <Entry x:Name="txtContraseña"
                       Placeholder="Ingresa la Contraseña"
                       IsPassword="True"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Button x:Name="btnIniciarSesion"
                        Text="Iniciar Sesión"
                        Clicked="btnIniciarSesion_Clicked"
                        Grid.Row="2"
                        Grid.Column="0"/>
                <Button x:Name="btnRegistrarUsuario"
                        Text="Registrar Usuario"
                        Clicked="btnRegistrarUsuario_Clicked"
                        Grid.Row="2"
                        Grid.Column="1"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>