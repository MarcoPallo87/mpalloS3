<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mpalloS3.Views.vRegistro"
             Title="vRegistro">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="DimGray"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="CharacterSpacing" Value="0,2"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </ContentPage.Resources> 
    
    <ScrollView Orientation="Both">
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            BackgroundColor="LightGray">
            <Label 
                Text="Registrar Usuario"
                FontSize="18"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Entry x:Name="txtUsuarioNuevo"
               Placeholder="Ingresa el nuevo usuario"/>
            <Entry x:Name="txtContrasena"
                   Placeholder="Ingresa la contraseña"/>

            <Grid ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnGuardarUsuario"
                        Text="Guardar Usuario"
                        Clicked="btnGuardarUsuario_Clicked"
                        Grid.Row="0"
                        Grid.Column="0"/>
                <Button x:Name="btnCancelar"
                        Text="Cancelar"
                        Clicked="btnCancelar_Clicked"
                        Grid.Row="0"
                        Grid.Column="1"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>